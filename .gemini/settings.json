{
  "context": {
    "fileName": [
      "GEMINI.md",
      "設計書.md"
    ]
  },
  "mcp": {
    "allowed": [
      "serena",
      "playwright",
      "linksee"
    ]
  },
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "/home/nabu_dvl/workspace/4-quadrant-action-board/care-compass"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "linksee": {
      "command": "npx",
      "args": [
        "-y",
        "linksee-memory"
      ]
    }
  },
  "general": {
    "preferredEditor": "vscode"
  },
  "experimental": {
    "skills": true
  }
}
